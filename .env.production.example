# ============================================================
# PRODUCTION .env — copy this to .env on your VPS
# Edit all values marked with <CHANGE_THIS>
# ============================================================

CI_ENVIRONMENT = production

# App URL — ganti dengan IP atau domain VPS kamu
app.baseURL = 'http://localhost:8080/'

# Frontend URL — sama dengan app.baseURL untuk single-server deploy
frontend.baseURL = 'http://localhost:8080/'

# ── DATABASE ────────────────────────────────────────────────
database.default.hostname = localhost
database.default.database = nama_mrn
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port     = 3306

# ── XENDIT (payment) ────────────────────────────────────────
xendit.APIKey = <XENDIT_KEY>

# ── SECURITY ────────────────────────────────────────────────
# Generate key: php spark key:generate
encryption.key = hex2bin:<CHANGE_THIS>
